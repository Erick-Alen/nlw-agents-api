DATABASE_URL=postgresql://docker:docker@localhost:5432/agents
PORT=3333

AI_PROVIDER=openai-compatible
AI_CHAT_URL=http://127.0.0.1:18081/v1/chat/completions
AI_CHAT_MODEL=qwen3.5-4b
AI_EMBEDDING_URL=http://127.0.0.1:18082/v1/embeddings
AI_EMBEDDING_MODEL=embeddinggemma-300m-q8_0
AI_EMBEDDING_FORMAT=embeddinggemma
AI_TRANSCRIPTION_URL=http://127.0.0.1:18083/v1/audio/transcriptions

# To use Gemini, set AI_PROVIDER=gemini and supply this key.
# GEMINI_APIKEY=YOUR_GEMINI_API_KEY
